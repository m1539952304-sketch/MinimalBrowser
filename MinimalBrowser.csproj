<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MinimalBrowser</RootNamespace>
    <AssemblyName>MinimalBrowser</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 嵌入 exe 的图标与版本信息 -->
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Product>MinimalBrowser</Product>
    <Description>Windows 上基于 WinForms + WebView2 的极简浏览器</Description>
    <Authors>m1539952304-sketch</Authors>
    <Copyright>Copyright (c) 2026 m1539952304-sketch</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
  </ItemGroup>

  <!-- 同一份图标再作为清单资源嵌一次，供窗口标题栏读取 -->
  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="MinimalBrowser.app.ico" />
  </ItemGroup>

</Project>